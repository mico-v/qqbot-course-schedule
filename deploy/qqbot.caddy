# QQ 课表机器人反向代理模板（单域名）
#
# 放置到 /etc/caddy/Caddyfile.d/qqbot.caddy，主 Caddyfile 需包含：
#   import /etc/caddy/Caddyfile.d/*.caddy
#
# 机器人回调 /webhook、健康检查 /healthz、卡片图片 /images/*、导出文件 /files/*
# 以及管理台 /admin、登录页 /login 全部走同一个域名；管理台由服务端会话
# Cookie 校验保护（config.json 的 admin_password），无需内网入口。
# 域名需有指向本机的 DNS；机器人监听 127.0.0.1:18080（见 config.json 的
# bind/port），Caddy 负责 TLS 与 443 对外。

kb.example.com {
	log {
		output file /var/log/caddy/qqbot_access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
	reverse_proxy 127.0.0.1:18080
}
